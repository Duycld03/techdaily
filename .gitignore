# --------------------------------------------------------------------
# Node / Nuxt 4 / Frontend Artifacts
# --------------------------------------------------------------------
node_modules/
.output/
.nuxt/
.nitro/
dist/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
