# ==============================================================================
# DeepPace — Single Environment Configuration Source
# ==============================================================================
# Keep real secret values ONLY in the gitignored `.env` file (never commit secrets).
#
# .NET binds double-underscore keys: Section__Key -> Section:Key.
# The SAME key names are used locally (run-dev.sh sources this file) and in
# production (docker-compose.prod.yml injects it via `env_file: .env`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 17 + pgvector)
# ------------------------------------------------------------------------------
# POSTGRES_PASSWORD is the single password source. run-dev.sh (Host=localhost) and
# docker-compose.prod.yml (Host=db) compose ConnectionStrings__DefaultConnection from it.
# Generate securely, e.g. openssl rand -base64 32
POSTGRES_USER=deeppace_user
POSTGRES_DB=deeppace_db
POSTGRES_PASSWORD=your_strong_postgres_password_here

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Token Security
# ------------------------------------------------------------------------------
# At least 256 bits of CSPRNG entropy, e.g. openssl rand -base64 44
Jwt__Secret=your_jwt_secret_key_32_characters_minimum_here
Jwt__Issuer=DeepPace
Jwt__Audience=DeepPaceUsers
Jwt__ExpiryMinutes=60

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (Social Sign-In)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID is canonical; run-dev.sh / compose derive both the backend
# (Authentication__Google__ClientId) and frontend (NUXT_PUBLIC_GOOGLE_CLIENT_ID) forms.
GOOGLE_CLIENT_ID=your_google_client_id_here
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
Authentication__Google__ClientSecret=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 4. Frontend & Nitro SSR Runtime
# ------------------------------------------------------------------------------
# Browser-facing target for API requests (relative in prod reverse proxy)
NUXT_PUBLIC_API_BASE_URL=http://localhost:5000
# Internal container network proxy URL for Nitro SSR (production)
# API_INTERNAL_URL=http://backend:5000

# ------------------------------------------------------------------------------
# 5. Gemini AI Engine (Active Recall & Quiz Curation)
# ------------------------------------------------------------------------------
Gemini__ApiKey=your_gemini_api_key_here
Gemini__Model=gemini-3.5-flash-lite
Gemini__EmbeddingModel=gemini-embedding-001

# ------------------------------------------------------------------------------
# 6. Google Cloud Text-to-Speech (Neural Narration)
# ------------------------------------------------------------------------------
# Server-side API key for high-speed neural audio narration synthesis.
Google__TtsApiKey=your_google_cloud_tts_api_key_here

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
WebPush__PublicKey=your_vapid_public_key_here
WebPush__PrivateKey=your_vapid_private_key_here
WebPush__Subject=mailto:support@deeppace.app

# ------------------------------------------------------------------------------
# 8. Transactional Email (SMTP) — OTP Verification & Password Reset
# ------------------------------------------------------------------------------
# Gmail requires an App Password (Google Account -> Security -> App passwords), not your login password.
# Host/Port/UseStartTls are non-secret defaults in appsettings.json.
Email__Smtp__From=your_gmail_address@gmail.com
Email__Smtp__Username=your_gmail_address@gmail.com
Email__Smtp__Password=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# 9. Automated E2E Test Credentials
# ------------------------------------------------------------------------------
# Used by automated E2E tests and health-check verifications
E2E_PROD_EMAIL=e2e_prod_agent@deeppace.local
E2E_PROD_PASSWORD=E2eLiveTestPass2026!

# ------------------------------------------------------------------------------
# Production Deployment & Reverse Proxy Wiring
# ------------------------------------------------------------------------------
# Allowed browser CORS origins for ASP.NET Core backend in production
CORS_ALLOWED_ORIGINS=https://deeppace.duckdns.org,https://techdaily.duckdns.org

# Optional log level override (production defaults to Information)
# Logging__LogLevel__Default=Debug
