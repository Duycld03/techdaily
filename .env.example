# Database Credentials
# POSTGRES_PASSWORD requires secure CSPRNG generation (e.g. openssl rand -base64 32)
POSTGRES_PASSWORD=your_strong_postgres_password_here
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=techdaily_db;Username=techdaily_user;Password=your_strong_postgres_password_here"

# JWT Authentication
# JWT_SECRET requires secure generation with at least 256 bits of CSPRNG entropy (e.g. openssl rand -base64 44)
JWT_SECRET=your_jwt_secret_key_32_characters_minimum_here

# Google OAuth (Public Client ID and Server Secret)
GOOGLE_CLIENT_ID=your_google_client_id_here
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini AI Service
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Web Push Notifications (VAPID Keys)
# VAPID_PRIVATE_KEY requires secure cryptographic generation (e.g. npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://techdaily.duckdns.org
