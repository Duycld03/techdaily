# ====================================================================
# TechDaily Environment Configuration Example
# ====================================================================

# Database Configuration (PostgreSQL 17 + pgvector)
POSTGRES_DB=techdaily_db
POSTGRES_USER=techdaily_user
POSTGRES_PASSWORD=techdaily_password_secret
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=techdaily_db;Username=techdaily_user;Password=techdaily_password_secret

# AI Engine (Google Gemini API)
Gemini__ApiKey=your_gemini_api_key_here
Gemini__Model=gemini-2.5-flash

# Telegram Notifications
Telegram__BotToken=your_telegram_bot_token_here
Telegram__DefaultChatId=

# Authentication (Google OAuth 2.0)
Authentication__Google__ClientId=your_google_client_id_here
Authentication__Google__ClientSecret=your_google_client_secret_here

# JWT Configuration
Jwt__Secret=a_super_secret_jwt_key_that_is_at_least_32_characters_long_12345
Jwt__Issuer=TechDaily
Jwt__Audience=TechDailyUsers
Jwt__ExpiryMinutes=1440
